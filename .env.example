DATABASE_URL=postgres://jj_roofing:jj_roofing_dev_password@localhost:5432/jj_roofing_dev
TEST_DATABASE_URL=postgres://jj_roofing:jj_roofing_dev_password@localhost:5432/jj_roofing_test
AUTH_SECRET=replace-with-a-generated-secret

# Object storage (ADR-005). Dev/test/CI default to the local filesystem backend
# (no cloud credentials needed); files go under .storage/ (gitignored).
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
#
# Production: set STORAGE_DRIVER=s3 and the S3-compatible bucket credentials
# (AWS S3, Cloudflare R2, MinIO, ...). STORAGE_S3_ENDPOINT is optional for AWS.
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=jj-roofing-documents
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
